{
  "name": "snag-api-poc",
  "version": "1.0.0",
  "description": "Proof-of-concept for Snag API integration - query loyalty data by wallet address",
  "main": "dist/server.js",
  "packageManager": "pnpm@8.0.0",
  "scripts": {
    "dev": "nodemon --exec ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "type-check": "tsc --noEmit"
  },
  "keywords": ["snag", "loyalty", "api", "poc"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "@types/node": "^20.10.6",
    "@types/express": "^4.17.21",
    "ts-node": "^10.9.2",
    "nodemon": "^3.0.2"
  }
}
